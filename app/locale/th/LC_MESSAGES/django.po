#: templates/registration/password_reset_confirm.html:24
msgid "New password"
msgstr "รหัสผ่านใหม่"

#: templates/registration/password_reset_confirm.html:39
msgid "Change password"
msgstr "เปลี่ยนรหัสผ่าน"

#: templates/registration/password_reset_confirm.html:45
msgid "This password reset link is invalid or has expired."
msgstr "ลิงก์รีเซ็ตรหัสผ่านนี้ไม่ถูกต้องหรือหมดอายุแล้ว"

#: templates/registration/password_reset_confirm.html:48
msgid ""
"It may have already been used. Please <a href=\"/password_reset/\">request a "
"new reset link</a>."
msgstr ""
"ลิงก์นี้อาจถูกใช้ไปแล้ว โปรด<a href=\"/password_reset/\">ขอลิงก์รีเซ็ตใหม่</a>"

#: templates/registration/password_reset_done.html:5
msgid "Password reset sent"
msgstr "ส่งคำขอรีเซ็ตรหัสผ่านแล้ว"

#: templates/registration/password_reset_done.html:9
msgid "Check your email"
msgstr "ตรวจสอบอีเมลของคุณ"

#: templates/registration/password_reset_done.html:12
msgid "Password reset email sent."
msgstr "ส่งอีเมลรีเซ็ตรหัสผ่านแล้ว"

#: templates/registration/password_reset_done.html:15
msgid ""
"If an account exists for the email you entered, you will receive a message "
"with instructions to reset your password shortly."
msgstr ""
"หากมีบัญชีสำหรับอีเมลที่คุณกรอก คุณจะได้รับข้อความพร้อมคำแนะนำในการรีเซ็ตรหัสผ่านในไม่ช้า"

#: templates/registration/password_reset_done.html:18
msgid ""
"If you do not receive an email within a few minutes, check your spam folder "
"or <a href=\"/password_reset/\">try again</a>."
msgstr ""
"หากคุณไม่ได้รับอีเมลภายในไม่กี่นาที โปรดตรวจสอบโฟลเดอร์สแปม หรือ<a href=\"/password_reset/\">ลองอีกครั้ง</a>"

#: templates/registration/password_reset_done.html:21
msgid "Back to login"
msgstr "กลับไปหน้าเข้าสู่ระบบ"

#: templates/registration/password_reset_form.html:5
msgid "Reset password"
msgstr "รีเซ็ตรหัสผ่าน"

#: templates/registration/password_reset_form.html:9
msgid "Reset your password"
msgstr "รีเซ็ตรหัสผ่านของคุณ"

#: templates/registration/password_reset_form.html:11
msgid ""
"Enter your account email address and we'll send you a link to reset your "
